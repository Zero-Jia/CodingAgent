FROM python:3.12-slim

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
        'Acquire::Retries "5";' \
        'Acquire::http::Pipeline-Depth "0";' \
        'Acquire::https::Pipeline-Depth "0";' \
        'Acquire::Queue-Mode "access";' \
        > /etc/apt/apt.conf.d/99coding-agent-network \
    && apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* /etc/apt/apt.conf.d/99coding-agent-network \
    && useradd --uid 10001 --create-home sandbox

RUN pip install --no-cache-dir uv==0.8.13

WORKDIR /opt/coding-agent
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --all-groups

ENV PATH="/opt/coding-agent/.venv/bin:${PATH}" \
    PYTHONPATH="/workspace/src"

USER 10001:10001
