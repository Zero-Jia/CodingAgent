# 切勿提交真实密钥；仅在本地进程环境中设置。
DEEPSEEK_API_KEY=replace-with-local-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
CODING_AGENT_SANDBOX_IMAGE=coding-agent-sandbox:python-3.12

# DashScope / Qwen text embedding for real semantic indexing.
# Do not commit real API keys. Use an endpoint from the same region as the API key.
# Beijing example: https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Singapore example: https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Virginia example: https://dashscope-us.aliyuncs.com/compatible-mode/v1
# qwen3.7-text-embedding supports 256-2560 dimensions; 1024 is the default
# cost/quality balance for general semantic search.
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_EMBEDDING_BATCH_SIZE=10

# Real Milvus backend for workspace semantic search.
CODING_AGENT_SEMANTIC_BACKEND=milvus
CODING_AGENT_MILVUS_URI=http://127.0.0.1:19530
CODING_AGENT_MILVUS_TOKEN=
CODING_AGENT_MILVUS_DATABASE=default
CODING_AGENT_MILVUS_COLLECTION=coding_agent_code_chunks
CODING_AGENT_SEMANTIC_TOP_K=8
CODING_AGENT_SEMANTIC_MAX_FILE_BYTES=800000
CODING_AGENT_SEMANTIC_MAX_CHUNK_CHARS=6000
CODING_AGENT_SEMANTIC_CHUNK_OVERLAP_CHARS=600
